{
    "name": "pulse-template",
    "version": "0.1.0",
    "description": "Template for self-hosted intelligence dashboards — multi-source aggregation, LLM briefing, live dashboard. Fork it, write a domain pack, ship your own pulse.",
    "type": "module",
    "bin": {
        "pulse": "./cli.mjs"
    },
    "files": [
        "cli.mjs",
        "server.mjs",
        "diag.mjs",
        "apis/",
        "lib/",
        "dashboard/public/",
        ".env.example"
    ],
    "engines": {
        "node": ">=22.0.0",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "start": "node cli.mjs",
        "dev": "node --trace-warnings server.mjs",
        "sweep": "node apis/briefing.mjs",
        "inject": "node dashboard/inject.mjs",
        "brief:save": "node apis/save-briefing.mjs",
        "diag": "node diag.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "release:patch": "npm version patch && git push --follow-tags",
        "release:minor": "npm version minor && git push --follow-tags",
        "release:major": "npm version major && git push --follow-tags"
    },
    "keywords": [
        "news",
        "dashboard",
        "intelligence",
        "osint",
        "rss",
        "template",
        "self-hosted"
    ],
    "author": "hugodendievel-cmd",
    "repository": {
        "type": "git",
        "url": "https://github.com/hugodendievel-cmd/pulse-template"
    },
    "license": "MIT",
    "dependencies": {
        "express": "^5.1.0",
        "express-rate-limit": "^8.3.1",
        "fast-xml-parser": "^5.5.8",
        "helmet": "^8.1.0",
        "pino": "^10.3.1"
    },
    "devDependencies": {
        "vitest": "^3.2.4"
    }
}
